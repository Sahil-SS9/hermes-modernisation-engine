Subject: [PATCH] Prepare isolated Python 3.14 and FastAPI compatibility
 candidate

---
 .github/workflows/ci.yml |   2 +-
 pyproject.toml           |   9 +--
 uv.lock                  | 119 ++++++++++++++++++++++++++++++++-------
 3 files changed, 105 insertions(+), 25 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 0d39091..779dcdb 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -15,7 +15,7 @@ jobs:
         # POSIX suite (AF_UNIX/SO_PEERCRED) runs on POSIX runners; Windows
         # evidence lives in the dedicated native-windows job (named pipes/DACL).
         os: [ubuntu-latest, macos-latest]
-        python-version: ["3.11", "3.12", "3.13"]
+        python-version: ["3.11", "3.12", "3.13", "3.14"]
     steps:
       - uses: actions/checkout@v4
       - name: Install uv
diff --git a/pyproject.toml b/pyproject.toml
index 066515e..1775a37 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -4,7 +4,7 @@ version = "0.1.0rc2"
 description = "Same-machine, cross-session agent messaging for AI harnesses — Hermes first."
 readme = "README.md"
 license = { text = "MIT" }
-requires-python = ">=3.11,<3.14"
+requires-python = ">=3.11,<3.15"
 authors = [{ name = "Sahil Saghir" }]
 keywords = ["agent", "messaging", "hermes", "ipc", "unix-socket", "peer"]
 classifiers = [
@@ -17,6 +17,7 @@ classifiers = [
     "Programming Language :: Python :: 3.11",
     "Programming Language :: Python :: 3.12",
     "Programming Language :: Python :: 3.13",
+    "Programming Language :: Python :: 3.14",
     "Topic :: Communications",
 ]
 # The core has zero runtime dependencies by design (ADR-0001). Hermes itself
@@ -29,7 +30,7 @@ dependencies = []
 # SID-bound DACL. Only needed on Windows; Linux/macOS remain dependency-light.
 windows = ["pywin32==310; sys_platform == 'win32'"]
 # Dashboard plugin API (FastAPI router mounted by the Hermes Desktop host).
-dashboard = ["fastapi==0.115.6"]
+dashboard = ["fastapi==0.133.1"]
 
 [project.entry-points."hermes_agent.plugins"]
 hermes-peer = "hermes_peer.plugin"
@@ -74,8 +75,8 @@ dev = [
     "ty==0.0.2",
     # Dashboard plugin tests exercise the FastAPI router (runtime gets it
     # from the Hermes core host).
-    "fastapi==0.115.6",
-    "httpx==0.27.2",
+    "fastapi==0.133.1",
+    "httpx==0.28.1",
     "pytest-asyncio==0.24.0",
     "websockets==14.1",
 ]
